# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS
FRONTEND_URL="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# Security & Authentication
JWT_SECRET="urban_ledger_secure_jwt_secret_key_2026_odoo"
JWT_EXPIRES_IN="1d"

# Database Connection (PostgreSQL + Prisma)
# OPTION 1 (RECOMMENDED): Online Cloud Database (Neon / Supabase / Render / Aiven)
# Anyone cloning your repo can paste their free cloud database URL here to connect immediately!
# Example for Neon: DATABASE_URL="postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Example for Supabase: DATABASE_URL="postgresql://postgres.projectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Example for Render: DATABASE_URL="postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_ledger?schema=public"

